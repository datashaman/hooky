OPENROUTER_API_KEY=

# Optional model overrides.
# OPENROUTER_MODEL=openai/gpt-oss-20b
# LOOP_EVALUATOR_MODEL=
# OPENROUTER_REASONING=
# OPENROUTER_CONTEXT_LENGTH=
# OPENROUTER_TIMEOUT_MS=120000

# Optional local Ollama override for planner/generator/contract roles.
# The visual evaluator still uses LOOP_EVALUATOR_MODEL/OpenRouter unless overridden.
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_THINK=

# Optional role budgets and loop caps.
# LOOP_PLANNER_MAX_COST_USD=0.10
# LOOP_GENERATOR_MAX_COST_USD=0.50
# LOOP_EVALUATOR_MAX_COST_USD=0.50
# LOOP_PLANNER_MAX_SECONDS=180
# LOOP_GENERATOR_MAX_SECONDS=600
# LOOP_EVALUATOR_MAX_SECONDS=600
# LOOP_CONTRACT_MAX_ROUNDS=5
# LOOP_ATTEMPT_MAX_ROUNDS=3

# Optional web search support.
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=

# Optional skill roots.
# HOOKY_SKILL_ROOTS=

# Optional role executor. Defaults to native (Hooky's built-in OpenRouter/Ollama
# tool runtime). The --executor CLI flag wins over this if both are set.
# See docs/agent-executors.md.
# HOOKY_EXECUTOR=native
# HOOKY_EXECUTOR=codex
# HOOKY_EXECUTOR=claude
# HOOKY_EXECUTOR=shell

# Optional overrides for HOOKY_EXECUTOR=codex. Unset lets Codex use its own
# ~/.codex/config.toml.
# HOOKY_CODEX_MODEL=gpt-5.5
# HOOKY_CODEX_REASONING_EFFORT=high

# Optional overrides for HOOKY_EXECUTOR=claude. Unset lets Claude Code use its
# own user/project/local settings.
# HOOKY_CLAUDE_MODEL=opusplan
# HOOKY_CLAUDE_EFFORT=medium

# Required for HOOKY_EXECUTOR=shell: a command template expanded with
# $workspace, $input, $output, $executor_dir, $mcp_config placeholders.
# HOOKY_EXECUTOR_COMMAND=python ./run-role.py $input $output

# Optional: let HOOKY_EXECUTOR=native consult a second model mid-task via
# OpenRouter's hosted "openrouter:advisor" server tool (only takes effect for
# OpenRouter models; ignored for ollama/*). Unset disables the tool entirely.
# See docs/agent-executors.md.
# HOOKY_ADVISOR_MODEL=anthropic/claude-opus-latest
# HOOKY_ADVISOR_INSTRUCTIONS=You are a terse senior engineering second opinion.
# HOOKY_ADVISOR_MAX_COMPLETION_TOKENS=400
